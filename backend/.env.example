# LLM Provider Configuration
# Choose: gemini or huggingface
LLM_PROVIDER=huggingface

# Google Gemini API Key (get from https://makersuite.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# HuggingFace API Key (optional - for Inference API, get from https://huggingface.co/settings/tokens)
HUGGINGFACE_API_KEY=your_huggingface_token_here

# Database (Local SQLite - No credentials needed)
DATABASE_PATH=./data/biz_agent.db

# Vector Database (Local ChromaDB - No credentials needed)
CHROMA_DB_PATH=./data/chroma_db

# WhatsApp (Set mock_mode=false to use real API)
WHATSAPP_MOCK_MODE=true
WHATSAPP_API_KEY=your_whatsapp_access_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=your_business_account_id
WHATSAPP_TEST_NUMBER=+919876543210

# GSTIN Validation (Set mock_mode=false to use real API)
GSTIN_MOCK_MODE=true
GST_API_KEY=your_gst_provider_api_key

# Optional: Google Translate API (Free tier available)
# GOOGLE_TRANSLATE_API_KEY=optional_for_better_hinglish_support
